#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}


# ──────────────────────────────────────────────────────────────────────────
# STAGES — instalar y autenticar un gestor de contrasenas.
#
# Objetivo: no volver a introducir credenciales. Cada opcion guarda lo minimo
# para que la sesion se renueve sola, sin pedir nada.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=4

SECRETS_DIR="$HOME/.secrets"
MANAGER=""
HOOK=""

pm() {
  if   command -v pacman  >/dev/null 2>&1; then echo pacman
  elif command -v apt-get >/dev/null 2>&1; then echo apt
  else echo desconocido; fi
}
aur_helper() {
  if   command -v paru >/dev/null 2>&1; then echo paru
  elif command -v yay  >/dev/null 2>&1; then echo yay
  else echo ""; fi
}
have() { command -v "$1" >/dev/null 2>&1; }

# write_hook FICHERO CONTENIDO — deja un fichero en ~/.secrets con permisos 600.
# ~/.shell_common.sh carga todos los *.sh de ahi, en bash y en zsh.
write_hook() {
  local name="$1" body="$2" path
  mkdir -p "$SECRETS_DIR"; chmod 700 "$SECRETS_DIR"
  path="$SECRETS_DIR/$name"
  printf '%s\n' "$body" > "$path"
  chmod 600 "$path"
  HOOK="$path"
  printf '  %s✓ escrito%s %s (modo 600)\n' "$GREEN" "$RESET" "$path"
}

# ── Stage 1 ───────────────────────────────────────────────────────────────
banner "secrets-setup · gestor de contrasenas"

stage "Elegir gestor"
say "La idea es autenticarse UNA vez y no volver a hacerlo. Cada opcion lo"
say "consigue de una forma distinta:"
printf '\n'
step "1password  Service account: un token de solo lectura que no caduca."
note "             Es el unico pensado para maquinas sin nadie delante."
step "bitwarden  API key + desbloqueo automatico. La sesion de Bitwarden"
note "             caduca por diseno, asi que se guardan las credenciales y un"
note "             wrapper la renueva solo cuando hace falta."
step "pass       Ficheros GPG en un repo git. Sin sesion ni nube: si el agente"
note "             GPG tiene la clave, no vuelve a pedir nada."
printf '\n'
note "Gestor de paquetes detectado: $(pm)"
printf '\n'
_try=0
while :; do
  ask MANAGER "¿Cual? [1password / bitwarden / pass]:"
  case "$MANAGER" in
    1password|bitwarden|pass) break ;;
  esac
  _try=$((_try + 1))
  # `ask` hace `read || true`: sin stdin interactivo esto daria vueltas para
  # siempre, asi que se corta a los 3 intentos.
  if (( _try >= 3 )); then warn "sin respuesta valida; abortando"; exit 1; fi
  warn "escribe una de las tres"
done

# ── Stage 2 ───────────────────────────────────────────────────────────────
stage "Instalar el CLI"

case "$MANAGER" in
  1password)
    if have op; then
      note "op ya instalado: $(op --version)"
    else
      case "$(pm)" in
        pacman)
          helper=$(aur_helper)
          if [[ -n "$helper" ]]; then
            say "1password-cli vive en el AUR."
            confirm "¿Ejecuto '$helper -S --needed 1password-cli'?" && "$helper" -S --needed 1password-cli
          else
            warn "no hay paru ni yay; instala uno y vuelve a ejecutar"
            SKIPPED+=("instalar 1password-cli desde el AUR")
          fi
          ;;
        apt)
          say "1Password publica su propio repo apt. Hacen falta permisos de root."
          if confirm "¿Lo anado e instalo op?"; then
            curl -sS https://downloads.1password.com/linux/keys/1password.asc \
              | sudo gpg --dearmor --yes --output /usr/share/keyrings/1password-archive-keyring.gpg
            echo "deb [arch=amd64 signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/amd64 stable main" \
              | sudo tee /etc/apt/sources.list.d/1password.list >/dev/null
            sudo apt-get update -qq && sudo apt-get install -y 1password-cli
          else
            SKIPPED+=("instalar 1password-cli")
          fi
          ;;
        *) warn "instala 'op' a mano desde 1password.com/downloads/command-line"
           SKIPPED+=("instalar 1password-cli") ;;
      esac
    fi
    ;;

  bitwarden)
    if have bw; then
      note "bw ya instalado: $(bw --version 2>/dev/null)"
    else
      say "El CLI oficial se distribuye como binario unico. Va a ~/.local/bin."
      if confirm "¿Descargo la ultima version de bw?"; then
        mkdir -p "$HOME/.local/bin"
        tmp=$(mktemp -d)
        if curl -sSL -o "$tmp/bw.zip" "https://vault.bitwarden.com/download/?app=cli&platform=linux" \
           && unzip -qo "$tmp/bw.zip" -d "$tmp"; then
          install -m 755 "$tmp/bw" "$HOME/.local/bin/bw"
          note "instalado en ~/.local/bin/bw"
        else
          warn "la descarga fallo; bajalo de github.com/bitwarden/clients/releases"
          SKIPPED+=("instalar bw")
        fi
        rm -rf "$tmp"
      else
        SKIPPED+=("instalar bw")
      fi
    fi
    ;;

  pass)
    if have pass; then
      note "pass ya instalado: $(pass version 2>/dev/null | head -1)"
    else
      case "$(pm)" in
        pacman) confirm "¿Ejecuto 'sudo pacman -S --needed pass'?" && sudo pacman -S --needed pass || SKIPPED+=("instalar pass") ;;
        apt)    confirm "¿Ejecuto 'sudo apt-get install -y pass'?"  && sudo apt-get install -y pass  || SKIPPED+=("instalar pass") ;;
        *)      warn "instala 'pass' con el gestor de tu distro"; SKIPPED+=("instalar pass") ;;
      esac
    fi
    ;;
esac

# ── Stage 3 ───────────────────────────────────────────────────────────────
stage "Autenticar de una vez por todas"

case "$MANAGER" in
  1password)
    say "Un service account es un token de solo lectura, ligado a un vault"
    say "concreto, que no caduca. Se pega una vez y ya no se toca."
    open_url "https://my.1password.eu/developer-tools/infrastructure-secrets/serviceaccount/"
    step "Create Service Account → ponle nombre (p.ej. 'dotfiles')"
    step "Dale acceso de solo lectura al vault que vayas a usar"
    step "Copia el token que empieza por 'ops_' — solo se muestra una vez"
    note "Si tu cuenta es .com y no .eu, cambia el dominio en la URL."
    ask_secret OP_TOKEN "Pega el token (no se vera al escribir):"
    if [[ -n "${OP_TOKEN:-}" ]]; then
      write_hook "10-1password.sh" "# generado por secrets-setup
# El token no caduca: \`op\` funciona en cualquier shell sin volver a autenticar.
export OP_SERVICE_ACCOUNT_TOKEN=\"$OP_TOKEN\""
    else
      warn "sin token: dependeras de la integracion con la app de escritorio"
      SKIPPED+=("token de service account de 1Password")
    fi
    ;;

  bitwarden)
    say "Bitwarden caduca la sesion por diseno, asi que para no re-autenticar"
    say "hacen falta dos piezas:"
    step "una API key (client_id + client_secret), que evita el login"
    step "la contrasena maestra, que permite el desbloqueo automatico"
    printf '\n'
    warn "La contrasena maestra quedaria en ~/.secrets/10-bitwarden.sh, en claro."
    note "El fichero va con permisos 600 y fuera del repo, pero quien lea tu"
    note "disco la lee. Si no te compensa, responde que no: se guardara solo la"
    note "API key y tendras que ejecutar 'bw unlock' cuando expire la sesion."
    printf '\n'
    open_url "https://vault.bitwarden.com/#/settings/security/security-keys"
    step "Baja a 'API key' → View API Key"
    step "Copia client_id y client_secret"
    ask        BW_ID     "client_id:"
    ask_secret BW_SECRET "client_secret:"

    BW_PASS=""
    if confirm "¿Guardar tambien la contrasena maestra para desbloqueo automatico?"; then
      ask_secret BW_PASS "Contrasena maestra:"
    fi

    if [[ -n "${BW_ID:-}" && -n "${BW_SECRET:-}" ]]; then
      if [[ -n "$BW_PASS" ]]; then
        write_hook "10-bitwarden.sh" "# generado por secrets-setup
# API key: evita el login interactivo. La contrasena permite el desbloqueo
# automatico. Exportarlas es barato; nada de esto llama a \`bw\` al arrancar.
export BW_CLIENTID=\"$BW_ID\"
export BW_CLIENTSECRET=\"$BW_SECRET\"
export BW_PASSWORD=\"$BW_PASS\"

# Wrapper: asegura una sesion valida justo antes del primer uso de \`bw\`, y
# solo entonces. Asi el arranque de la shell no paga el coste de desbloquear.
bw() {
  if [ -z \"\${BW_SESSION:-}\" ] || ! command bw unlocked >/dev/null 2>&1; then
    command bw login --apikey --quiet >/dev/null 2>&1 || true
    BW_SESSION=\"\$(command bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null)\"
    export BW_SESSION
  fi
  command bw \"\$@\"
}"
        note "Con esto \`bw\` se desbloquea solo la primera vez que lo uses en"
        note "cada shell. No vuelve a pedir nada."
      else
        write_hook "10-bitwarden.sh" "# generado por secrets-setup
# Solo la API key: evita el login, pero el desbloqueo sigue siendo manual.
# Cuando la sesion expire:  export BW_SESSION=\\\$(bw unlock --raw)
export BW_CLIENTID=\"$BW_ID\"
export BW_CLIENTSECRET=\"$BW_SECRET\""
        SKIPPED+=("desbloqueo automatico de Bitwarden (no se guardo la contrasena)")
      fi
    else
      warn "faltan client_id o client_secret"
      SKIPPED+=("API key de Bitwarden")
    fi
    ;;

  pass)
    say "pass cifra cada secreto con GPG. No hay sesion que expire: mientras el"
    say "agente GPG tenga la clave en cache, no vuelve a pedir la frase."
    if gpg --list-secret-keys --keyid-format=long 2>/dev/null | grep -q sec; then
      note "ya tienes al menos una clave GPG:"
      gpg --list-secret-keys --keyid-format=long 2>/dev/null | grep -A1 '^sec' | head -4
    else
      say "No hay ninguna clave secreta. Vamos a crear una."
      pause "Enter para lanzar 'gpg --full-generate-key' (RSA 4096, sin caducidad)…"
      gpg --full-generate-key || { warn "no se creo la clave"; SKIPPED+=("crear clave GPG"); }
    fi
    ask GPG_ID "ID o email de la clave con la que cifrar el almacen:"
    if [[ -n "${GPG_ID:-}" ]]; then
      pass init "$GPG_ID" && note "almacen creado en ~/.password-store"
      confirm "¿Lo convierto en repo git (recomendado para sincronizar)?" && pass git init
      printf '\n'
      say "Para que el agente no pida la frase a cada rato, sube su cache:"
      note "  ~/.gnupg/gpg-agent.conf"
      note "    default-cache-ttl 28800"
      note "    max-cache-ttl 86400"
      if confirm "¿Se lo anado ahora (8 h de cache)?"; then
        mkdir -p "$HOME/.gnupg"; chmod 700 "$HOME/.gnupg"
        grep -q '^default-cache-ttl' "$HOME/.gnupg/gpg-agent.conf" 2>/dev/null || \
          printf 'default-cache-ttl 28800\nmax-cache-ttl 86400\n' >> "$HOME/.gnupg/gpg-agent.conf"
        gpgconf --reload gpg-agent 2>/dev/null || true
        printf '  %s✓ escrito%s ~/.gnupg/gpg-agent.conf\n' "$GREEN" "$RESET"
      fi
    else
      SKIPPED+=("pass init")
    fi
    ;;
esac

# ── Stage 4 ───────────────────────────────────────────────────────────────
stage "Verificar"

say "Comprobamos que lee de verdad, sin pedir nada."
printf '\n'
ok=0
case "$MANAGER" in
  1password)
    # shellcheck source=/dev/null
    [[ -n "$HOOK" ]] && . "$HOOK"
    if have op && op whoami >/dev/null 2>&1; then
      op whoami | sed 's/^/  /'
      printf '\n  %svaults visibles:%s\n' "$BOLD" "$RESET"
      op vault list 2>/dev/null | sed 's/^/  /'
      ok=1
    fi
    ;;
  bitwarden)
    # shellcheck source=/dev/null
    [[ -n "$HOOK" ]] && . "$HOOK"
    if have bw; then
      command bw login --apikey --quiet >/dev/null 2>&1 || true
      if [[ -n "${BW_PASSWORD:-}" ]]; then
        BW_SESSION="$(command bw unlock --passwordenv BW_PASSWORD --raw 2>/dev/null)"
        export BW_SESSION
      fi
      if [[ -n "${BW_SESSION:-}" ]] && command bw unlocked >/dev/null 2>&1; then
        printf '  %s entradas en la boveda\n' "$(command bw list items 2>/dev/null | grep -o '"id"' | wc -l)"
        ok=1
      else
        command bw status 2>/dev/null | sed 's/^/  /'
      fi
    fi
    ;;
  pass)
    if have pass && [[ -d "$HOME/.password-store" ]]; then
      pass ls 2>/dev/null | head -10 | sed 's/^/  /'
      ok=1
    fi
    ;;
esac

printf '\n'
if (( ok )); then
  printf '  %s✓ %s responde sin pedir credenciales%s\n' "$GREEN" "$MANAGER" "$RESET"
  if [[ -n "$HOOK" ]]; then
    note "Se carga solo en cada shell: ~/.shell_common.sh hace source de todos"
    note "los *.sh de ~/.secrets, en bash y en zsh."
    note "Abre una terminal nueva o ejecuta: . $HOOK"
  fi
else
  warn "$MANAGER no respondio. Revisa los pasos anteriores y vuelve a ejecutar."
  SKIPPED+=("verificar el acceso a $MANAGER")
fi

printf '\n'
note "Este asistente NO guarda ningun secreto en el repo de dotfiles."
note "Solo escribe en ~/.secrets/, que esta fuera de chezmoi y de git."

finish
