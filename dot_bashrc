# ~/.bashrc — minimo y portable (Ubuntu/WSL, VPS, CachyOS).
# Lo compartido con zsh (PATH, nvm, editor, aliases, secrets) vive en
# ~/.shell_common.sh. Ajustes de un solo host: ~/.bashrc.local (no versionado).

# Solo shells interactivos
case $- in *i*) ;; *) return ;; esac

# --- Historial ----------------------------------------------------------------
HISTCONTROL=ignoreboth
HISTSIZE=5000
HISTFILESIZE=10000
shopt -s histappend checkwinsize

# --- Prompt de reserva --------------------------------------------------------
# starship lo sustituye más abajo si está instalado. Esto es lo que ves si no
# lo está (verde usuario@host, azul cwd).
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# --- Color en ls/grep ---------------------------------------------------------
if command -v dircolors >/dev/null 2>&1; then
  eval "$(dircolors -b)"
  alias ls='ls --color=auto'
  alias grep='grep --color=auto'
fi

# --- Completions --------------------------------------------------------------
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# --- Config compartida bash/zsh -----------------------------------------------
[ -r "$HOME/.shell_common.sh" ] && . "$HOME/.shell_common.sh"

# --- Prompt y herramientas ----------------------------------------------------
# Después de shell_common: starship puede vivir en ~/.local/bin, que se añade
# al PATH ahí. Misma config que zsh (~/.config/starship.toml).
command -v starship >/dev/null 2>&1 && eval "$(starship init bash)"
command -v zoxide   >/dev/null 2>&1 && eval "$(zoxide init bash)"
command -v direnv   >/dev/null 2>&1 && eval "$(direnv hook bash)"

# --- Node: completions de nvm (solo bash) -------------------------------------
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# --- Overrides por maquina (no versionado, se carga al final) ------------------
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
