{{/* Configuración de la máquina — se resuelve UNA vez en `chezmoi init` y queda
     guardada en ~/.config/chezmoi/chezmoi.toml.

     `bootstrap.sh` hace estas mismas preguntas con una interfaz más cómoda,
     exporta las respuestas como DOTFILES_* y llama con `--promptDefaults`, así
     que en el flujo normal nada de esto llega a preguntarse aquí. Estos
     prompts son el camino de respaldo para quien use `chezmoi init` a pelo.

     Se usan variables de entorno y no `--promptString`: ese flag se indexa por
     el TEXTO del prompt, así que reescribir una pregunta romperia el bootstrap
     en silencio.

     Los defaults salen de `sh -c "... || true"` y no de `output "git" ...` a
     secas: `git config --get` devuelve 1 cuando la clave no existe, y eso
     abortaría la plantilla en una máquina sin git configurado. */}}
{{- $gitName  := output "sh" "-c" "git config --global --get user.name  2>/dev/null || true" | trim -}}
{{- $gitEmail := output "sh" "-c" "git config --global --get user.email 2>/dev/null || true" | trim -}}
{{- $ghUser   := output "sh" "-c" "gh api user --jq .login 2>/dev/null || true" | trim -}}
{{- $anEditor := "" -}}
{{- range list "nvim" "vim" "micro" "nano" -}}
{{-   if and (eq $anEditor "") (lookPath .) }}{{ $anEditor = . }}{{ end -}}
{{- end -}}
{{- if eq $anEditor "" }}{{ $anEditor = "vim" }}{{ end -}}

{{- /* Cada default sale de su DOTFILES_*, y si no está, de lo detectado.
       Para los booleanos se compara contra la cadena "true" en vez de usar
       `default`: sprig considera vacío el false booleano, así que
       `... | default true` convertiría un false explícito en true. */ -}}

{{- /* --- Identidad --- */ -}}
{{- $name  := promptStringOnce . "name"        "Tu nombre para git"   (env "DOTFILES_NAME"   | default $gitName)  -}}
{{- $email := promptStringOnce . "email"       "Tu email para git"    (env "DOTFILES_EMAIL"  | default $gitEmail) -}}
{{- $gh    := promptStringOnce . "github_user" "Tu usuario de GitHub" (env "DOTFILES_GH"     | default $ghUser)   -}}

{{- /* --- Preferencias --- */ -}}
{{- $editor := promptStringOnce . "editor"     "Editor por defecto (nvim/vim/micro/nano)" (env "DOTFILES_EDITOR" | default $anEditor) -}}
{{- $branch := promptStringOnce . "git_branch" "Rama por defecto en repos nuevos"         (env "DOTFILES_BRANCH" | default "main")    -}}
{{- $rebase := promptBoolOnce   . "git_rebase" "¿`git pull` con rebase en vez de merge?"  (eq (env "DOTFILES_REBASE" | default "false") "true") -}}

{{- /* --- Qué instalar --- */ -}}
{{- $docker := promptBoolOnce . "docker" "¿Instalar Docker?"                          (eq (env "DOTFILES_DOCKER" | default "true")  "true")  -}}
{{- $k8s    := promptBoolOnce . "k8s"    "¿Aliases de Kubernetes (kubectl)?"          (eq (env "DOTFILES_K8S"    | default "false") "true") -}}
{{- $ai     := promptBoolOnce . "ai"     "¿Aliases de agentes de IA (claude, codex)?" (eq (env "DOTFILES_AI"     | default "false") "true") -}}

{{- /* --- Autodetectado --- */ -}}
{{- $wsl := false -}}
{{- if hasKey .chezmoi "kernel" -}}
{{-   $wsl = contains "microsoft" (.chezmoi.kernel.osrelease | lower) -}}
{{- end -}}

[data]
    name        = {{ $name   | quote }}
    email       = {{ $email  | quote }}
    github_user = {{ $gh     | quote }}
    editor      = {{ $editor | quote }}
    git_rebase  = {{ $rebase }}
    git_branch  = {{ $branch | quote }}
    docker      = {{ $docker }}
    k8s         = {{ $k8s }}
    ai          = {{ $ai }}
    wsl         = {{ $wsl }}
